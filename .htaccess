# ASE — Apache configuration (v6.1.0)
# Works on Apache 2.2 and 2.4 (SiteGround, cPanel, most shared hosts).

# ── Never serve internal files ────────────────────────────────────────────────
# Settings, secrets, rate-limit state, lock files and temp files. These are read
# and written by the PHP scripts only.
<FilesMatch "^(\.ase_config\.lock|ase_config\.json.*|auth_secret\.key|auth_rate\.json|cron_token\.key|notify_secret\.key|notify_rate\.json|cron_notify_sent\.json|ssl_cache\.json|uptime\.json.*|domains\.stats|\.ase_config\.lock|cron\.log|demo\.flag|_ase\.php)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Dotfiles and VCS metadata
<FilesMatch "^\.(git|ht|env)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# ── Only the HTTP methods ASE uses ────────────────────────────────────────────
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{REQUEST_METHOD} ^(PUT|DELETE|TRACE|TRACK|CONNECT|PATCH) [NC]
    RewriteRule .* - [F,L]

    # HTTPS only (the session cookie is Secure on HTTPS). Skipped on localhost.
    RewriteCond %{HTTPS} off
    RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
    RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)(:\d+)?$ [NC]
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# ── Headers ───────────────────────────────────────────────────────────────────
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "same-origin"

    # Always fetch fresh app code after an update
    <FilesMatch "\.(html|js|css|php)$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
    </FilesMatch>
</IfModule>

# Do not leak directory listings
Options -Indexes
